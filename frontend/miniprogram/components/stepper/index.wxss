.st-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.st-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.st-label {
  font-size: 24rpx;
  color: #7a8499;
  margin-bottom: 6rpx;
}
/* 标签后的附加区：提示文字 + 可点按钮（如「或者 不休息」） */
.st-extra {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 auto;
  margin-bottom: 6rpx;
}
.st-extra-text {
  font-size: 24rpx;
  color: #7a8499;
}
.st-extra-btn {
  font-size: 24rpx;
  color: #d6453d;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #fdecec;
  line-height: 1.3;
}
.st-btn {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #2f6fed;
}
.st-val {
  width: 96rpx;
  height: 64rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}
.st-unit {
  color: #7a8499;
  font-size: 24rpx;
  margin-right: 6rpx;
}
.st-quick {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.st-q {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #eef3fe;
  color: #2f6fed;
  font-size: 24rpx;
}
