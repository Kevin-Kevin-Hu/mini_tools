.tp-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 30, 50, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.tp-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}
.tp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.tp-title {
  font-weight: 700;
}
.tp-cancel {
  color: #7a8499;
}
.tp-ok {
  color: #2f6fed;
  font-weight: 700;
}
.tp-view {
  height: 400rpx;
}
.tp-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
