.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.grow {
  flex: 1;
}
.lbl {
  font-size: 26rpx;
  color: #7a8499;
}
.in {
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 34rpx;
  background: #fbfcfe;
  margin-bottom: 16rpx;
}
.keys {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.key {
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.key.op {
  background: #f3f6fc;
  color: #2f6fed;
  font-weight: 700;
}
.key.del {
  color: #d6453d;
}
.rel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.rel-side {
  flex: 1;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 6rpx 8rpx;
  background: #fbfcfe;
}
.rel-side.focus {
  border-color: #2f6fed;
  background: #f3f8ff;
}
.rel-in {
  font-size: 34rpx;
  padding: 10rpx 14rpx;
}
.rel-eq {
  font-size: 36rpx;
  font-weight: 700;
  color: #7a8499;
}
.rel-del {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d6453d;
  font-size: 30rpx;
}
.q {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.q-side {
  flex: 1;
}
.target {
  background: #eef3fe;
  color: #2f6fed;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 12rpx 30rpx;
}
