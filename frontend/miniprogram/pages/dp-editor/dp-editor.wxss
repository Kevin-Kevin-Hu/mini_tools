.pad {
  padding: 48rpx 32rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.grow {
  flex: 1;
}
.title {
  font-size: 34rpx;
  font-weight: 800;
}
.seg {
  display: inline-flex;
  border: 1rpx solid #e3e8f0;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f3f6fc;
}
.seg-btn {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: #44506a;
}
.seg-btn.on {
  background: #2f6fed;
  color: #fff;
  font-weight: 700;
}
.save {
  margin-top: 12rpx;
  font-size: 22rpx;
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.save.error {
  background: #fdecec;
  color: #d6453d;
}
.lbl {
  font-size: 24rpx;
  color: #7a8499;
  margin-bottom: 10rpx;
}
.timebtn {
  display: inline-block;
  background: #eef3fe;
  color: #2f6fed;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  font-size: 32rpx;
}

.task {
  background: #fff;
  border: 1rpx solid #e3e8f0;
  border-left: 8rpx solid #2f6fed;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
}
.task.k-break {
  border-left-color: #f0a93d;
  background: #fffaf0;
}
.task.k-meal {
  border-left-color: #e06b9c;
  background: #fff5fa;
}
.task.viewing {
  padding: 20rpx 24rpx;
}
.t-time {
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.badge {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  background: #eef3fe;
  color: #2f6fed;
}
.badge.b-break {
  background: #fdf3e2;
  color: #e8930c;
}
.badge.b-meal {
  background: #fdeaf2;
  color: #e06b9c;
}
.mini-acts {
  display: flex;
  gap: 8rpx;
}
.mini-btn {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f6fed;
  font-size: 30rpx;
}
.mini-btn.dis {
  opacity: 0.35;
}
.mini-btn.edit {
  background: #2f6fed;
  color: #fff;
  font-size: 28rpx;
}
.v-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.v-detail {
  color: #7a8499;
  font-size: 26rpx;
  margin-top: 4rpx;
}
.v-meta {
  color: #7a8499;
  font-size: 24rpx;
  margin-top: 8rpx;
}
.t-title {
  margin-top: 14rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  background: #fbfcfe;
}
.t-detail {
  margin-top: 12rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  width: auto;
  min-height: 60rpx;
  background: #fbfcfe;
}
.ctl {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
/* 任务操作行：复制/删除并排一行
   用 <view> 而非 <button>：微信 <button> 默认 margin-left/right:auto，
   在 flex 容器里会各占一行并撑满整行宽度。 */
.task-acts {
  margin-top: 12rpx;
  flex-wrap: nowrap;
  gap: 12rpx;
}
.act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  box-sizing: border-box;
  flex: 0 0 auto;
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--line);
}
.act.danger {
  color: var(--danger);
  border-color: #f2c7c4;
}
.act-hover {
  opacity: 0.6;
}
.end {
  text-align: center;
  color: #7a8499;
  font-size: 26rpx;
  margin: 8rpx 0 24rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
/* chip 用 <view> 自绘：微信 <button> 在 flex 容器里会被撑成整宽、各占一行 */
.chip {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #e3e8f0;
  color: #2f6fed;
  font-size: 26rpx;
  line-height: 1.3;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
  flex: 0 0 auto;
}
.chip.preset {
  background: #eef3fe;
  border-color: #d5e2fc;
}
.chip-hover {
  opacity: 0.6;
}
.pad-h {
  padding: 0 32rpx 40rpx;
}
.printbtn {
  background: #fff;
  border: 1rpx solid var(--line);
  color: var(--brand);
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}
.grip {
  color: #b6bdcc;
  font-size: 34rpx;
  padding: 8rpx 10rpx 8rpx 0;
}
.task.dragging {
  opacity: 0.55;
  border-color: #2f6fed;
}
.in {
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #fbfcfe;
  width: auto;
}
.manage {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f7f9ff;
  border: 1rpx solid #e3e8f0;
  border-radius: 16rpx;
}
.mg-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eef1f6;
}
.mg-name {
  font-weight: 600;
}
.mg-dur {
  color: #7a8499;
  font-size: 24rpx;
}
.mg-add {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.print-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 1200rpx;
}
