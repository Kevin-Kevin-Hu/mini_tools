.field {
  margin-bottom: 24rpx;
}
.field:last-of-type {
  margin-bottom: 0;
}
.lbl {
  font-size: 28rpx;
  color: #44506a;
}
.picker {
  background: #eef3fe;
  color: #2f6fed;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 14rpx;
  padding: 12rpx 28rpx;
}

/* 分段按钮组（步骤 / 题型，直点切换，避免下拉） */
.seg {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.seg-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 14rpx;
  font-size: 30rpx;
  background: #eef3fe;
  color: #2f6fed;
  border: 1rpx solid #dbe5fb;
  box-sizing: border-box;
}
.seg-btn.on {
  background: #2f6fed;
  color: #fff;
  border-color: #2f6fed;
  font-weight: 700;
}
.seg-btn-hover {
  opacity: 0.75;
}
.hint {
  color: #7a8499;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

/* 顶部抬头预览（与打印一致） */
.pv-hdr {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 36rpx;
  margin-bottom: 20rpx;
}
.pv-hdr-item {
  display: flex;
  align-items: flex-end;
  font-size: 26rpx;
  color: #1a2233;
}
.blank {
  border-bottom: 1rpx solid #1a2233;
  margin: 0 4rpx;
}
.blank.sm {
  width: 130rpx;
}
.blank.lg {
  width: 240rpx;
}
.blank.xs {
  width: 64rpx;
}

/* 题目预览列表（两列） */
.pv-list {
  height: 560rpx;
  background: #fafbfe;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}
.pv-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
  font-size: 28rpx;
}
.pv-line {
  color: #1a2233;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 操作块（并排，避免 button 在 flex 里被撑满） */
.acts {
  display: flex;
  gap: 20rpx;
}
.act {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  color: #2f6fed;
  border: 1rpx solid #e3e8f0;
  box-sizing: border-box;
}
.act.primary {
  background: #2f6fed;
  color: #fff;
  border-color: #2f6fed;
}
.act-hover {
  opacity: 0.7;
}

/* 离屏画布：移出可视区，但需保持布局（2d canvas 必须参与布局才能渲染） */
.ws-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}
