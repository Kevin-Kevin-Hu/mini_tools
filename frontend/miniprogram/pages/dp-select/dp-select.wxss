.pad {
  padding: 48rpx 32rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.grow {
  flex: 1;
}
.user-chip {
  background: #eef3fe;
  color: #2f6fed;
  font-weight: 700;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  white-space: nowrap;
}
/* 用户行：头像 + 三个操作，同一行 */
.u-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.u-pick {
  flex: 0 0 auto;
  min-width: 0;
}
/* 操作块（替代 <button>，避免微信默认 margin:auto 把按钮挤成各占一行） */
.acts {
  display: flex;
  gap: 12rpx;
  flex: 0 0 auto;
}
.act {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.3;
  white-space: nowrap;
  box-sizing: border-box;
  flex: 0 0 auto;
  background: #fff;
  color: var(--brand);
  border: 1rpx solid var(--line);
}
.act.primary {
  background: var(--brand);
  color: #fff;
  border: none;
}
.act.danger {
  color: var(--danger);
  border-color: #f2c7c4;
}
.act.dis {
  opacity: 0.45;
}
.act-hover {
  opacity: 0.6;
}
.newplan {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7f9ff;
  border: 1rpx solid #e3e8f0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.newplan .btn {
  width: 100%;
}
.np-date,
.np-time {
  background: #fff;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.plan-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* 允许换行：复制面板用 flex-basis:100% 折到卡片第二行 */
  flex-wrap: wrap;
  border: 1rpx solid #e3e8f0;
  border-left: 8rpx solid #2f6fed;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-top: 16rpx;
  background: #fff;
}
.plan-main {
  flex: 1;
  min-width: 0;
}
.plan-date {
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
}
.plan-label {
  color: #2f6fed;
  font-size: 24rpx;
  margin-top: 4rpx;
}
.plan-acts {
  display: flex;
  gap: 10rpx;
  flex: 0 0 auto;
}
/* 复制面板：占满卡片宽度，单独一行；用 picker 代替原来的日期输入框 */
.cp {
  flex: 0 0 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e3e8f0;
}
.cp picker {
  flex: 1;
  min-width: 0;
}
.cp-date {
  background: #f7f9ff;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
