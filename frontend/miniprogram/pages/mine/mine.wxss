.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.grow {
  flex: 1;
}
.avatar,
.m-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #2f6fed;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}
.m-avatar {
  width: 64rpx;
  height: 64rpx;
  font-size: 28rpx;
}
.nick {
  font-size: 36rpx;
  font-weight: 800;
}
.btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.code-box {
  margin: 20rpx 0;
  background: #f7f9ff;
  border: 1rpx solid #d5e2fc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.code {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #2f6fed;
}
.copy {
  background: #2f6fed;
  color: #fff;
  border-radius: 24rpx;
  padding: 10rpx 32rpx;
  font-size: 26rpx;
}
.lbl {
  font-size: 24rpx;
  color: #7a8499;
  margin: 20rpx 0 10rpx;
}
.member {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}
.m-name {
  font-size: 30rpx;
  font-weight: 600;
}
.mini-btn {
  border: 1rpx solid #e3e8f0;
  background: #fff;
  color: #2f6fed;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}
